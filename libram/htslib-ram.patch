+// As for CRAM, an iterator for which hts_itr_next() simply invokes readrec,
+// with the region set on the RAM file.
+static hts_itr_t *ram_itr_query(const hts_idx_t *idx, int tid, hts_pos_t beg, hts_pos_t end, hts_readrec_func *readrec)
+{
+    struct RamFile *ram = ((const hts_ram_idx_t *) idx)->ram;
+    hts_itr_t *iter = (hts_itr_t *) calloc(1, sizeof(hts_itr_t));
+    if (iter == NULL) return NULL;
+    iter->read_rest = 1;
+    iter->readrec = readrec;
+    iter->tid = tid;
+    iter->beg = beg;
+    iter->end = end;
+
+    int ret = 0;
+    if (tid >= 0) {
+        // ram_query takes a region as text, 1-based and inclusive.
+        const char *name = sam_hdr_tid2name(ram_header(ram), tid);
+        kstring_t region = KS_INITIALIZE;
+        if (name == NULL || beg >= INT32_MAX) {
+            iter->finished = 1;
+        } else if (ksprintf(&region, "%s:%"PRIhts_pos"-%"PRIhts_pos, name, beg + 1,
+                            end < INT32_MAX ? end : INT32_MAX) < 0) {
+            ret = -1;
+        } else {
+            ret = ram_query(ram, region.s);
+        }
+        ks_free(&region);
+    } else if (tid == HTS_IDX_START || tid == HTS_IDX_REST) {
+        ret = ram_query(ram, NULL);
+    } else if (tid == HTS_IDX_NONE) {
+        iter->finished = 1;
+    } else {
+        hts_log_error("Query with tid=%d not implemented for RAM files", tid);
+        ret = -1;
+    }
+    if (ret < 0) {
+        if (ram_error(ram)) hts_log_error("%s", ram_error(ram));
+        free(iter);
+        return NULL;
+    }
+    return iter;
+}
